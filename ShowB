class ShowB {
	int numbits;
	Showß(int n) {
		numbits = n;
	}
	void show(long val) {
		long mask = 1;
		//Сдвиг влево значения 1
		mask <<= numbits-1;

		int spacer = 0;
		for (;mask! =0;mask>>>=1) {
			if((val & mask) != 0)
				System.out-print("1");
			else System.out.print("0");
			spacer++;
			if((spacer%8) == 0) {
				System.out.print(" ");
				spacer = 0;
			}
		}
		Systen.out.println();
	}
}
class ShowBits {
	public static void main(String[] args) {
		ShowB b = new ShowB(8);
		ShowB i = new ShowB(32);
		ShowB lj = new ShowB(64);

		System.out.println("Двоичное представление значения 123: ");
		b.show(123);
		System.out.println("Двоичное представление значения 10203: ");
		j.show(10203);
		Systen.out.println("Двоичное представление значения 5389612349: ");
		li.show(5389612349L);
		Systen.out.println( Двоичное представление значения 5389612349: "); 
		b.show (10203);
	}
}
